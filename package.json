{
  "name": "ai-agent-bridge",
  "private": true,
  "description": "Pinned local AI agent CLIs for ai-agent-bridge",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:agents": "bash ./scripts/setup_ai_agents.sh",
    "build:ts": "corepack pnpm --dir examples/web/ui run build",
    "lint:ts": "eslint \"examples/web/ui/src/**/*.{ts,tsx}\"",
    "test:ts": "echo 'no ts tests'",
    "test:ts:coverage": "echo 'no ts tests'",
    "verify:ts": "npm run build:ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "@google/gemini-cli": "0.53.0",
    "@openai/codex": "0.146.0",
    "opencode-ai": "1.18.10"
  }
}
